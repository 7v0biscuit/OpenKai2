function(openkai2_add_discord project_root enable_tests)
    if(TARGET openkai2_discord_presence)
        return()
    endif()
    find_package(Threads REQUIRED)
    add_library(openkai2_discord_presence STATIC "${project_root}/src/discord_presence.cpp")
    target_include_directories(openkai2_discord_presence PUBLIC "${project_root}/src")
    target_compile_features(openkai2_discord_presence PUBLIC cxx_std_17)
    target_link_libraries(openkai2_discord_presence PUBLIC Threads::Threads)
    if(enable_tests AND WIN32)
        add_executable(openkai2_discord_tests "${project_root}/tests/discord_presence_tests.cpp")
        target_link_libraries(openkai2_discord_tests PRIVATE openkai2_discord_presence)
        add_test(NAME discord_local_ipc COMMAND openkai2_discord_tests)
        set_tests_properties(discord_local_ipc PROPERTIES TIMEOUT 30)
    endif()
endfunction()
