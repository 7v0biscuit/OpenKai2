+class IoRegisterFile
+{
+public:
+    class iterator
+    {
+    public:
+        struct Entry
+        {
+            uint32_t first;
+            uint32_t &second;
+        };
+        struct Arrow
+        {
+            Entry entry;
+            Entry *operator->() { return &entry; }
+        };
+        iterator() = default;
+        iterator(uint32_t address, uint32_t *value) : m_address(address), m_value(value) {}
+        Entry operator*() const { return {m_address, *m_value}; }
+        Arrow operator->() const { return Arrow{{m_address, *m_value}}; }
+        bool operator==(const iterator &other) const { return m_value == other.m_value; }
+        bool operator!=(const iterator &other) const { return m_value != other.m_value; }
+
+    private:
+        uint32_t m_address = 0;
+        uint32_t *m_value = nullptr;
+    };
+
+    uint32_t &operator[](uint32_t address)
+    {
+        const uint32_t slot = index(address);
+        if (slot < kSlots)
+        {
+            m_present.set(slot);
+            return m_values[slot];
+        }
+        return m_other[address];
+    }
+    size_t count(uint32_t address) const
+    {
+        const uint32_t slot = index(address);
+        return slot < kSlots ? size_t(m_present.test(slot)) : m_other.count(address);
+    }
+    iterator find(uint32_t address) const
+    {
+        auto &self = const_cast<IoRegisterFile &>(*this);
+        const uint32_t slot = index(address);
+        if (slot < kSlots)
+            return m_present.test(slot) ? iterator(address, &self.m_values[slot]) : iterator();
+        const auto found = self.m_other.find(address);
+        return found == self.m_other.end() ? iterator() : iterator(address, &found->second);
+    }
+    iterator end() const { return iterator(); }
+    void clear()
+    {
+        m_values.fill(0u);
+        m_present.reset();
+        m_other.clear();
+    }
+    template <typename Archive>
+    void serializeState(Archive &archive)
+    {
+        archive.bytes(m_values.data(), sizeof(uint32_t) * kSlots);
+        archive.bytes(&m_present, sizeof m_present);
+        archive(m_other);
+    }
+
+private:
+    static constexpr uint32_t kSlots = PS2_IO_SIZE / 4u;
+    static uint32_t index(uint32_t address)
+    {
+        const uint32_t offset = address - PS2_IO_BASE;
+        return offset < PS2_IO_SIZE && (offset & 3u) == 0u ? offset >> 2 : kSlots;
+    }
+    std::array<uint32_t, kSlots> m_values{};
+    std::bitset<kSlots> m_present;
+    std::unordered_map<uint32_t, uint32_t> m_other;
+};
