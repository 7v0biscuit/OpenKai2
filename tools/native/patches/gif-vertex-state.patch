 namespace
 {
+    // GIF's temporary Q resets per tag; RGBA copies it into RGBAQ.Q.
+    // STQ alone must not change the Q attached to subsequent vertices.
+    void latchPackedQ(uint8_t descriptor, uint64_t hi, float& temporaryQ, float& vertexQ)
+    {
+        if (descriptor == 2u)
+        {
+            const uint32_t bits = static_cast<uint32_t>(hi);
+            std::memcpy(&temporaryQ, &bits, sizeof(temporaryQ));
+            if (temporaryQ == 0.0f)
+                temporaryQ = 1.0f;
+        }
+        else if (descriptor == 1u)
+            vertexQ = temporaryQ;
+    }
