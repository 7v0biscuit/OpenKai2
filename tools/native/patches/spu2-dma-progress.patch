+    uint32_t IopMemory::readGuestHardware32(uint32_t address) const
+    {
+        const uint32_t value = readHardware32(address);
+        for (uint32_t core = 0; core < 2u; ++core)
+        {
+            const uint32_t chcr = core ? kDmaSpu1Chcr : kDmaSpu0Chcr;
+            const AutoDmaTransfer &transfer = m_autoDma[core];
+            if ((address != chcr && address != chcr - 8u) || clock() >= transfer.end)
+                continue;
+            if (address == chcr)
+                return value | kDmaStart;
+            // The SPU2 takes one 1 KiB block of 256 stereo frames at a time,
+            // the first as soon as the transfer starts.
+            const uint64_t blocks = 1u + (clock() - transfer.start) / (256u * 768u);
+            return transfer.base + uint32_t(std::min<uint64_t>(transfer.bytes, blocks * 1024u));
+        }
+        return value;
+    }
