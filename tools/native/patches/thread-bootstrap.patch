diff --git a/Kernel/Syscalls/Thread.cpp b/Kernel/Syscalls/Thread.cpp
--- a/Kernel/Syscalls/Thread.cpp
+++ b/Kernel/Syscalls/Thread.cpp
@@ -180,8 +180,19 @@
         setReturnS32(ctx, KE_OK);
     }
 
-    void InitThread(uint8_t *, R5900Context *ctx, PS2Runtime *)
-    {
+    void InitThread(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        EeScheduler &ee = scheduler(rdram, ctx, runtime);
+        // The SDK startup routine moves the bootstrap thread from kernel
+        // priority zero to user priority one. Later guest workers inherit the
+        // priority reported by ReferThreadStatus, so returning success alone
+        // leaves their CreateThread descriptors with an illegal priority.
+        const GuestThread *self = ee.currentThread();
+        if (self && self->currentPriority == 0)
+        {
+            int oldPriority = 0;
+            ee.changePriority(self->id, 1, false, oldPriority);
+        }
         setReturnS32(ctx, EeScheduler::kMainThreadId);
     }
 
