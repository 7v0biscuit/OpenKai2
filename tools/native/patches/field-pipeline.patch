+void GS::enqueueCommandLocked(uint32_t kind, const void *payload, uint32_t size)
+{
+    const size_t at = m_pending.size();
+    m_pending.resize(at + 16u + ((size + 15u) & ~15u));
+    std::memcpy(m_pending.data() + at, &size, sizeof(size));
+    std::memcpy(m_pending.data() + at + 4u, &kind, sizeof(kind));
+    std::memcpy(m_pending.data() + at + 16u, payload, size);
+    if (!m_workerBusy && !m_workerWake)
+    {
+        m_workerWake = true;
+        m_queueReady.notify_one();
+    }
+}
+
+void GS::setFieldCallback(std::function<void(uint64_t)> callback)
+{
+    fence();
+    std::lock_guard<std::mutex> lock(m_fieldMutex);
+    m_fieldCallback = std::move(callback);
+}
+
+void GS::beginField()
+{
+    if (!m_worker.joinable() || onWorker())
+        return;
+    bool queued = false;
+    {
+        std::lock_guard<std::mutex> lock(m_fieldMutex);
+        queued = static_cast<bool>(m_fieldCallback);
+    }
+    if (!queued)
+    {
+        fence();
+        return;
+    }
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    if (m_fieldsDone >= m_fieldsSent)
+        return;
+    openkai2::RuntimeWorkTimer wait(openkai2::RuntimeWork::gsFence);
+    m_queueDrained.wait(lock, [this]() { return m_fieldsDone >= m_fieldsSent; });
+}
+
+bool GS::endField(uint64_t tick)
+{
+    if (!m_worker.joinable() || onWorker() || !m_privRegs)
+        return false;
+    {
+        std::lock_guard<std::mutex> lock(m_fieldMutex);
+        if (!m_fieldCallback)
+            return false;
+    }
+    const uint64_t field[] = {tick, m_privRegs->pmode, m_privRegs->smode2, m_privRegs->dispfb1, m_privRegs->display1,
+                              m_privRegs->dispfb2, m_privRegs->display2, m_privRegs->bgcolor};
+    std::lock_guard<std::mutex> lock(m_queueMutex);
+    ++m_fieldsSent;
+    enqueueCommandLocked(2u, field, sizeof(field));
+    return true;
+}
+
+void GS::finishField(const uint8_t *payload)
+{
+    uint64_t field[8];
+    std::memcpy(field, payload, sizeof(field));
+    {
+        std::lock_guard<std::recursive_mutex> state(m_stateMutex);
+        GSPresentationRequest request = buildPresentationRequestUnlocked();
+        request.pmode = field[1];
+        request.smode2 = field[2];
+        request.dispfb1 = field[3];
+        request.display1 = field[4];
+        request.dispfb2 = field[5];
+        request.display2 = field[6];
+        request.bgcolor = field[7];
+        request.vsyncTick = field[0];
+        m_fieldRequest = request;
+        m_hasFieldRequest = true;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_queueMutex);
+        ++m_fieldsDone;
+        m_queueDrained.notify_all();
+    }
+    std::lock_guard<std::mutex> lock(m_fieldMutex);
+    if (m_fieldCallback)
+        m_fieldCallback(field[0]);
+}
