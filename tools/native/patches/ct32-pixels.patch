+            sourceOver=(ctx.alpha&255u)==0x44u;
+            asel=ctx.alpha&3u;bsel=(ctx.alpha>>2u)&3u;
+            csel=(ctx.alpha>>4u)&3u;dsel=(ctx.alpha>>6u)&3u;fix=(ctx.alpha>>32u)&255u;
+            pabe=state.pabe;
+            writesDepth=!ctx.zbuf.zmask;
+        }
+        bool write(int x,int y,uint32_t z,uint8_t r,uint8_t g,uint8_t b,uint8_t a) const {
+            if(!enabled)return false;
+            if(depthMethod==0u)return true;
+            if(depthMethod>=2u && !(depthMethod==2u && z==UINT32_MAX)) {
+                const uint32_t oldDepth=readDepth(vram,depthBase,width,x,y);
