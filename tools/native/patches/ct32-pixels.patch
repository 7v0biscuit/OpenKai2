+            :vram(memory),readDepth(rd),readFrame(rf),writeFrame(wf),writeDepth(wd) {
+            const auto& ctx=state.context;
+            frameBase=framePageBaseToBlock(ctx.frame.fbp);
+            depthBase=framePageBaseToBlock(ctx.zbuf.zbp);
