+    // Return false for states that require the general test/format pipeline.
+    // Color precedes depth even when their VRAM addresses alias.
+    struct PreparedPixelWriter {
+        using Read=uint32_t(*)(uint8_t*,uint32_t,uint32_t,uint32_t,uint32_t);
+        using Write=void(*)(uint8_t*,uint32_t,uint32_t,uint32_t,uint32_t,uint32_t);
