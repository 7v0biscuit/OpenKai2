+                auto select=[&](uint8_t which) {
+                    return which==0u ? source : which==1u ? destination : _mm_setzero_si128();
+                };
+                __m128i color=select(dsel);
+                if(factor!=0 && asel!=bsel) {
+                    const auto delta=_mm_sub_epi32(select(asel),select(bsel));
+                    color=_mm_add_epi32(color,_mm_srai_epi32(_mm_mullo_epi32(delta,_mm_set1_epi32(factor)),7));
