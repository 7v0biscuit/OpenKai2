+
+namespace {
+    openkai2::LatchedPadState hostPads[2];
+}
+namespace openkai2 {
+void reset_host_input() {
+    for (auto& pad:hostPads) pad.reset();
+}
+void poll_host_input() {
+    for (int port=0;port<2;++port) {
+        auto value=LatchedPadState::neutral();
+        sampleHostPad(port,value.data(),value.size());
+        hostPads[port].publish(value);
+    }
+}
+}
+bool PSPadBackend::readState(int port,int slot,uint8_t* data,size_t size) {
+    if (!data || size<32u) return false;
+    const auto value=port>=0 && port<2 && slot==0
+        ? hostPads[port].consume() : openkai2::LatchedPadState::neutral();
+    std::memcpy(data,value.data(),value.size());
+    if (port>=0 && port<2 && slot==0) openkai2::observe_pad_packet(port,data);
+    return true;
+}
