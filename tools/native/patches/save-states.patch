+    archive(m_vtxCount, m_vtxIndex, m_lastDisplayBaseBytes, m_preferredDisplaySourceFrame, m_preferredDisplayDestFbp);
+    archive(m_hasPreferredDisplaySource);
+    std::vector<uint8_t> vram;
+    if (!archive.loading() && m_backend)
+        m_backend->SnapshotVram(vram);
+    archive(vram);
+    if (archive.loading() && m_localMemoryStorage && vram.size() == m_localMemorySize)
