+bool EeScheduler::stateSavable(std::string *reason) const
+{
+    auto fail = [&](const char *why)
+    {
+        if (reason)
+            *reason = why;
+        return false;
+    };
+    if (m_currentThreadId != 0)
+        return fail("a guest thread is running");
+    if (!m_pendingInvocations.empty())
+        return fail("a guest callback is queued");
+    for (const auto &[id, thread] : m_threads)
+    {
+        if (!thread.invocations.empty())
+            return fail("a guest callback is running");
+        if (thread.resumeCompletion || thread.wait.completion)
+            return fail("a guest thread waits on a host operation");
+    }
+    return true;
+}
+
+void EeScheduler::serializeState(StateArchive &archive)
+{
+    std::string reason;
+    if (!archive.loading() && !stateSavable(&reason))
+        throw std::runtime_error("Cannot save the EE now: " + reason);
+    archive.section(0x48435345u);
+    uint64_t threadCount = m_threads.size();
+    archive(threadCount);
+    if (archive.loading())
+        m_threads.clear();
+    std::vector<int> ids;
+    for (const auto &[id, thread] : m_threads)
+        ids.push_back(id);
+    for (uint64_t i = 0; i < threadCount; ++i)
+    {
+        int id = archive.loading() ? 0 : ids[size_t(i)];
+        archive(id);
+        GuestThread &thread = m_threads[id];
+        archive(thread.id, thread.context, thread.entry, thread.stack, thread.stackSize, thread.gp, thread.attr);
+        archive(thread.option, thread.arg, thread.initialPriority, thread.currentPriority, thread.status);
+        archive(thread.suspendCount, thread.wakeupCount, thread.ownsStack, thread.tlsBase);
+        archive(thread.wait.reason, thread.wait.payload);
+        if (archive.loading())
+        {
+            thread.wait.completion = {};
+            thread.resumeCompletion = {};
+            thread.invocations.clear();
+        }
+    }
+    archive(m_readyQueues, m_semaphores, m_eventFlags, m_alarms, m_intcHandlers, m_dmacHandlers);
+    archive(m_nextThreadId, m_nextInvocationThreadId, m_nextSemaphoreId, m_nextEventFlagId, m_nextAlarmId);
+    archive(m_nextIntcHandlerId, m_nextDmacHandlerId, m_intcHeadOrder, m_intcTailOrder, m_dmacHeadOrder, m_dmacTailOrder);
+    archive(m_enabledIntcMask, m_enabledDmacMask, m_rescheduleRequested, m_timeSliceExpired, m_insideInterrupt);
+    archive(m_pendingEeTimerInterrupts, m_eeCycle, m_sliceEndCycle);
+    archive(m_vsyncTick, m_vsyncFlagAddress, m_vsyncTickAddress, m_gsVSyncCallback, m_gsVSyncCallbackGp, m_gsVSyncCallbackSp);
+    archive(m_invocationStackTops, m_invocationSequence);
+    {
+        std::lock_guard lock(m_eventMutex);
+        archive(m_events, m_eventSequence);
+        const auto now = std::chrono::steady_clock::now();
+        uint64_t deadlineCount = m_deadlines.size();
+        archive(deadlineCount);
+        if (archive.loading())
+            m_deadlines.assign(size_t(deadlineCount), ScheduledEvent{});
+        for (auto &deadline : m_deadlines)
+        {
+            int64_t later = std::chrono::duration_cast<std::chrono::nanoseconds>(deadline.hostDeadline - now).count();
+            archive(deadline.deadlineCycle, later, deadline.event, deadline.sequence);
+            if (archive.loading())
+                deadline.hostDeadline = now + std::chrono::nanoseconds(later - openkai2::restore_rebase_ns.load(std::memory_order_relaxed));
+        }
+        if (archive.loading())
+            updateNextDeadline();
+    }
+    if (archive.loading())
+    {
+        m_pendingInvocations.clear();
+        m_currentThreadId = 0;
+        m_runtime.memory().gs().vsyncTick.store(m_vsyncTick, std::memory_order_release);
+    }
+}
