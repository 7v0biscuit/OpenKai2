+void EeScheduler::serializeMachine(StateArchive &archive)
+{
+    archive.section(0x314b4f4fu);
+    m_runtime.m_gs.serializeState(archive);
+    m_runtime.m_memory.serializeState(archive);
+    m_runtime.m_vu0.serializeState(archive);
+    m_runtime.m_vu1.serializeState(archive);
+    archive(m_runtime.m_cpuContext);
+    {
+        std::lock_guard<std::mutex> lock(m_runtime.m_guestHeapMutex);
+        archive(m_runtime.m_guestHeapBlocks, m_runtime.m_guestHeapBase, m_runtime.m_guestHeapEnd);
+        archive(m_runtime.m_guestHeapLimit, m_runtime.m_guestHeapSuggestedBase, m_runtime.m_guestHeapConfigured);
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_runtime.m_asyncCallbackStackMutex);
+        archive(m_runtime.m_asyncCallbackStackFloor, m_runtime.m_asyncCallbackStackTop);
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_runtime.m_eeKernelStateMutex);
+        archive(m_runtime.m_eeExitHandlers, m_runtime.m_eeSyscallOverrides, m_runtime.m_eeSyscallMirrorAddresses);
+    }
+    serializeState(archive);
+    auto *iop = ps2x::iop::detail::IopEmulator::active();
+    if (!iop)
+        throw std::runtime_error("The IOP is not running");
+    iop->serializeState(archive);
+    openkai2::spu2::serialize(archive);
+    archive.section(0x444e454fu);
+}
