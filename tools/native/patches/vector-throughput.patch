+    // SSE4.1 is required by this runtime. MinGW's fesetround probes CPUID on
+    // every call; update the same x87/SSE rounding bits directly on x86.
+    int vectorRoundingMode() noexcept {
+#if defined(__GNUC__) && (defined(__i386__) || defined(__x86_64__))
+        static_assert(FE_TOWARDZERO==0xc00 && FE_DOWNWARD==0x400 && FE_UPWARD==0x800);
+        unsigned short control;__asm__ __volatile__("fnstcw %0" : "=m"(control));
+        return control&0xc00u;
+#else
+        return std::fegetround();
+#endif
+    }
+    bool setVectorRoundingMode(int mode) noexcept {
+#if defined(__GNUC__) && (defined(__i386__) || defined(__x86_64__))
+        if((mode&~0xc00)!=0)return false;
+        unsigned short control;__asm__ __volatile__("fnstcw %0" : "=m"(control));
+        control=static_cast<unsigned short>((control&~0xc00u)|unsigned(mode));
+        __asm__ __volatile__("fldcw %0" : : "m"(control) : "memory");
+        _mm_setcsr((_mm_getcsr()&~0x6000u)|(unsigned(mode)<<3u));
+        return true;
+#else
+        return std::fesetround(mode)==0;
+#endif
+    }
