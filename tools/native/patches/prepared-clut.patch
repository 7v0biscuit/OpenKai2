     thread_local GSMem::TexturePageCache* s_parallelTextureCache = nullptr;
+    // The GS latches palette entries separately from texture VRAM. Cache the
+    // resolved colors using the actual latched bytes and every lookup state
+    // field, so skipped CLD loads, TEXA changes, reset, and backend reuse retain
+    // their original behavior. Several slots avoid rebuilding alternating CLUTs.
+    thread_local const std::array<uint32_t,256>* s_preparedClut = nullptr;
+    struct ClutScope {
+        const std::array<uint32_t,256>* previous=s_preparedClut;
+        explicit ClutScope(const std::array<uint32_t,256>* colors) {s_preparedClut=colors;}
+        ~ClutScope(){s_preparedClut=previous;}
+    };
+    struct PreparedClutCache {
+        struct Entry {
+            uint64_t key=0;
+            bool valid=false;
+            std::array<uint16_t,512> latched{};
+            std::array<uint32_t,256> colors{};
+        };
+        std::array<Entry,4> entries{};
+        unsigned last=0,next=0;
+        uint64_t draws=0,hits=0,builds=0,scalar=0;
+        void report() {
+            ++draws;
+            if(draws>=1024u && draws<=4194304u && (draws&(draws-1u))==0u)
+                std::cerr << "[GS:palette] draws=" << draws << " hits=" << hits
+                          << " builds=" << builds << " scalar=" << scalar << '\n';
+        }
+        template<class Resolve>
+        const std::array<uint32_t,256>* prepare(uint64_t key,
+                const std::array<uint16_t,512>& latched,unsigned count,bool build,Resolve&& resolve) {
+            auto matches=[&](const Entry& entry){return entry.valid && entry.key==key
+                && std::memcmp(entry.latched.data(),latched.data(),sizeof(latched))==0;};
+            if(matches(entries[last])){++hits;report();return &entries[last].colors;}
+            for(unsigned i=0;i<entries.size();++i)if(i!=last && matches(entries[i])) {
+                last=i;++hits;report();return &entries[i].colors;
+            }
+            // Small primitives with a cold or rapidly changing palette retain
+            // scalar lookup; resolving 256 colors would cost more than sampling.
+            if(!build){++scalar;report();return nullptr;}
+            last=next;next=(next+1u)%unsigned(entries.size());auto& entry=entries[last];
+            entry.valid=true;entry.key=key;entry.latched=latched;
+            for(unsigned i=0;i<count;++i)entry.colors[i]=resolve(uint8_t(i));
+            if(count==16u)for(unsigned i=16u;i<256u;++i)entry.colors[i]=entry.colors[i&15u];
+            ++builds;report();return &entry.colors;
+        }
+    };
