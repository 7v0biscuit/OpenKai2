+GS::~GS()
+{
+    stopWorker();
+}
+
+void GS::startWorker()
+{
+    if (m_worker.joinable())
+        return;
+    if (const char *mode = std::getenv("OPENKAI2_GS_THREAD"); mode && mode[0] == '0')
+        return;
+    m_stopWorker = false;
+    // Packets are queued only after this returns, so the worker never needs
+    // its id before it is published here.
+    m_worker = std::thread([this]() { workerLoop(); });
+    m_workerId = m_worker.get_id();
+}
+
+void GS::stopWorker()
+{
+    if (!m_worker.joinable())
+        return;
+    {
+        std::lock_guard<std::mutex> lock(m_queueMutex);
+        m_stopWorker = true;
+    }
+    m_queueReady.notify_one();
+    m_worker.join();
+    m_workerId = {};
+}
+
+void GS::workerLoop()
+{
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    for (;;)
+    {
+        m_queueReady.wait(lock, [this]() { return m_stopWorker || !m_pending.empty(); });
+        if (m_pending.empty())
+            return;
+        m_working.swap(m_pending);
+        m_workerBusy = true;
+        m_workerWake = false;
+        lock.unlock();
+        for (size_t offset = 0; offset + 16u <= m_working.size();)
+        {
+            uint32_t size = 0;
+            std::memcpy(&size, m_working.data() + offset, sizeof(size));
+            processGIFPacketNow(m_working.data() + offset + 16u, size);
+            offset += 16u + ((size + 15u) & ~15u);
+        }
+        m_working.clear();
+        lock.lock();
+        m_workerBusy = false;
+        if (m_pending.empty())
+            m_queueDrained.notify_all();
+    }
+}
+
+void GS::fence()
+{
+    if (!m_worker.joinable() || onWorker())
+        return;
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    if (m_pending.empty() && !m_workerBusy)
