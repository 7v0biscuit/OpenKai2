+    bool interruptsEnabled(const R5900Context& context) {
+        // EIE and IE must be set; EXL/ERL defer maskable interrupts.
+        return (context.cop0_status & 0x00010007u) == 0x00010001u;
+    }
+
+    bool maskableInvocation(GuestInvocationKind kind) {
+        return kind == GuestInvocationKind::Interrupt || kind == GuestInvocationKind::Alarm
+            || kind == GuestInvocationKind::GsCallback;
+    }
