+void PS2Memory::startDmaWorker()
+{
+    const char *value = std::getenv("OPENKAI2_DMA_THREAD");
+    if ((value && *value == '0') || m_dmaWorker.joinable())
+        return;
+    {
+        std::lock_guard<std::mutex> lock(m_dmaMutex);
+        m_dmaStop = false;
+        m_dmaFailure = nullptr;
+    }
+    m_dmaWorker = std::thread([this]() { runDmaWorker(); });
+    m_dmaWorkerId = m_dmaWorker.get_id();
+    m_dmaRunning.store(true, std::memory_order_release);
+}
+
+void PS2Memory::stopDmaWorker()
+{
+    if (!m_dmaWorker.joinable())
+        return;
+    {
+        std::lock_guard<std::mutex> lock(m_dmaMutex);
+        m_dmaStop = true;
+    }
+    m_dmaReady.notify_all();
+    m_dmaWorker.join();
+    m_dmaRunning.store(false, std::memory_order_release);
+    m_dmaWorkerId = std::thread::id{};
+}
+
+bool PS2Memory::queueDma(DmaJob &&job)
+{
+    if (job.kind == 0u && (job.context & 0xC00u) != 0u)
+    {
+        drainDma();
+        return false;
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_dmaMutex);
+        if (m_dmaFailure)
+            std::rethrow_exception(m_dmaFailure);
+        m_dmaJobs.push_back(std::move(job));
+        ++m_dmaQueued;
+    }
+    m_dmaReady.notify_one();
+    return true;
+}
+
+bool PS2Memory::deferToDma(std::function<void()> work)
+{
+    if (!m_dmaRunning.load(std::memory_order_acquire) || onDmaWorker())
+        return false;
+    DmaJob job;
+    job.kind = 2u;
+    job.work = std::move(work);
+    return queueDma(std::move(job));
+}
+
+void PS2Memory::drainDma() const
+{
+    if (!m_dmaRunning.load(std::memory_order_acquire) || onDmaWorker())
+        return;
+    std::unique_lock<std::mutex> lock(m_dmaMutex);
+    if (m_dmaDone != m_dmaQueued)
+    {
+        openkai2::RuntimeWorkTimer wait(openkai2::RuntimeWork::gsFence);
+        m_dmaIdle.wait(lock, [this]() { return m_dmaDone == m_dmaQueued; });
+    }
+    if (m_dmaFailure)
+        std::rethrow_exception(m_dmaFailure);
+}
+
+void PS2Memory::runDmaWorker()
+{
+    std::unique_lock<std::mutex> lock(m_dmaMutex);
+    for (;;)
+    {
+        m_dmaReady.wait(lock, [this]() { return m_dmaStop || !m_dmaJobs.empty(); });
+        if (m_dmaJobs.empty())
+            return;
+        DmaJob job = std::move(m_dmaJobs.front());
+        m_dmaJobs.pop_front();
+        const bool failed = static_cast<bool>(m_dmaFailure);
+        lock.unlock();
+        if (!failed)
+        {
+            try
+            {
+                openkai2::RuntimeWorkTimer work(openkai2::RuntimeWork::dmaPending);
+                m_dmaJobContext = job.context;
+                if (job.kind == 0u)
+                    processVIF1Data(job.bytes.data(), static_cast<uint32_t>(job.bytes.size()));
+                else if (job.kind == 1u)
+                    submitGifPacket(static_cast<GifPathId>(job.path), job.bytes.data(), static_cast<uint32_t>(job.bytes.size()), job.drain, job.directHl);
+                else if (job.work)
+                    job.work();
+            }
+            catch (...)
+            {
+                lock.lock();
+                if (!m_dmaFailure)
+                    m_dmaFailure = std::current_exception();
+                lock.unlock();
+            }
+        }
+        lock.lock();
+        ++m_dmaDone;
+        if (m_dmaDone == m_dmaQueued)
+            m_dmaIdle.notify_all();
+    }
+}
