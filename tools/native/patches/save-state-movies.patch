+    bool mpegPlaybackActive()
+    {
+        std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
+        static std::unordered_map<uint32_t, std::pair<uint32_t, std::chrono::steady_clock::time_point>> progress;
+        const auto now = std::chrono::steady_clock::now();
+        bool active = false;
+        for (const auto &[mpegAddr, playback] : g_mpeg_stub_state.playbackByMpeg)
+        {
+            const bool playing = !playback.decodedFrames.empty() ||
+                                 (playback.sawInput && !playback.streamEnded && !playback.sawSequenceEnd && !playback.decoderFailed);
+            if (!playing)
+                continue;
+            auto &seen = progress[mpegAddr];
+            if (seen.first != playback.picturesServed || seen.second.time_since_epoch().count() == 0)
+                seen = {playback.picturesServed, now};
+            if (now - seen.second < std::chrono::seconds(1))
+                active = true;
+        }
+        return active;
+    }
+
+    void serializeMpegState(StateArchive &archive)
+    {
+        std::lock_guard<std::mutex> lock(g_mpeg_stub_mutex);
+        auto &state = g_mpeg_stub_state;
+        archive.section(0x4745504du);
+        archive(state.initialized, state.nextCallbackHandle, state.cdStreamGeneration, state.cdStreamBytesProduced);
+        archive(state.cdStreamBytesDemuxed, state.cdStreamEofPending, state.currentCdStreamEofSeen);
+        uint64_t callbackCount = state.callbacksByMpeg.size();
+        archive(callbackCount);
+        if (archive.loading())
+            state.callbacksByMpeg.clear();
+        auto callback = state.callbacksByMpeg.begin();
+        for (uint64_t i = 0; i < callbackCount; ++i)
+        {
+            uint32_t mpegAddr = archive.loading() ? 0u : callback->first;
+            uint64_t entries = archive.loading() ? 0u : callback->second.size();
+            archive(mpegAddr, entries);
+            auto &list = state.callbacksByMpeg[mpegAddr];
+            if (archive.loading())
+                list.resize(size_t(entries));
+            for (auto &entry : list)
+                archive(entry.type, entry.streamId, entry.func, entry.data, entry.handle, entry.stream);
+            if (!archive.loading())
+                ++callback;
+        }
+        uint64_t playbackCount = state.playbackByMpeg.size();
+        archive(playbackCount);
+        if (archive.loading())
+            state.playbackByMpeg.clear();
+        auto playback = state.playbackByMpeg.begin();
+        for (uint64_t i = 0; i < playbackCount; ++i)
+        {
+            uint32_t mpegAddr = archive.loading() ? 0u : playback->first;
+            archive(mpegAddr);
+            auto &entry = state.playbackByMpeg[mpegAddr];
+            archive(entry.width, entry.height, entry.decodeMode, entry.imageBufferAddr, entry.cdStreamGeneration);
+            archive(entry.sawInput, entry.sawSequenceEnd, entry.streamEnded, entry.decoderFailed);
+            if (!archive.loading())
+                ++playback;
+        }
+        if (archive.loading())
+        {
+            state.ipuInput.clear();
+            state.ipuTerminal = false;
+            ++state.ipuGeneration;
+        }
+    }
