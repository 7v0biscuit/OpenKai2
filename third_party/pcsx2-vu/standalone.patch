--- a/common/emitter/x86emitter.cpp
+++ b/common/emitter/x86emitter.cpp
@@ -1224,20 +1224,30 @@
 #ifdef _WIN32
 		xPUSH(rdi);
 		xPUSH(rsi);
-		xSUB(rsp, 32); // Windows calling convention specifies additional space for the callee to spill registers
-		m_offset += 48;
+		// Reserve the ABI shadow space plus XMM6-XMM15. OpenKai2 enters
+		// microVU from ordinary C++ callers, which retain these registers.
+		xSUB(rsp, 32 + 10 * 16);
+		m_offset += 48 + 10 * 16;
 #endif
 
 		stackAlign(m_offset, true);
+#ifdef _WIN32
+		for (int reg = 6; reg < 16; ++reg)
+			xMOVAPS(ptr128[rsp + 32 + (reg - 6) * 16], xRegisterSSE(reg));
+#endif
 	}
 
 	xScopedStackFrame::~xScopedStackFrame()
 	{
+#ifdef _WIN32
+		for (int reg = 6; reg < 16; ++reg)
+			xMOVAPS(xRegisterSSE(reg), ptr128[rsp + 32 + (reg - 6) * 16]);
+#endif
 		stackAlign(m_offset, false);
 
 		// Restore the register context
 #ifdef _WIN32
-		xADD(rsp, 32);
+		xADD(rsp, 32 + 10 * 16);
 		xPOP(rsi);
 		xPOP(rdi);
 #endif
