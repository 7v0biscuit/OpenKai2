* text=auto
*.py text eol=lf
*.sh text eol=lf
*.cmake text eol=lf
*.cpp text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.cmd text eol=crlf

# Unified diffs use a single space for an empty context line.
*.patch text eol=lf whitespace=-blank-at-eol

# Keep upstream license text unchanged, including its original whitespace.
third_party/licenses/** -whitespace

# Preserve unmodified upstream shader headers.
third_party/fidelityfx-fsr/** -whitespace
