#version 430 core
// One invocation owns one destination pixel. Tile command lists retain guest
// draw order. Texture/target aliases are synchronized by the host backend.
layout(local_size_x=8,local_size_y=8) in;
layout(std430,binding=0) buffer Vram {uint memory[];};
layout(std430,binding=1) readonly buffer Commands {uint commands[];};
layout(std430,binding=2) readonly buffer Tiles {uint tiles[];};
layout(std430,binding=3) readonly buffer References {uint references[];};
layout(std430,binding=4) readonly buffer Palettes {uint palettes[];};
layout(std430,binding=5) readonly buffer AddressTables {uint tables[];};
