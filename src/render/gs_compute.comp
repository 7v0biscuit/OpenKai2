    vec4 d=vec4(unpackColor(samplePoint(c,low+ivec2(0,1))));
    vec4 e=vec4(unpackColor(samplePoint(c,low+ivec2(1,1))));
    precise vec4 top=a+(b-a)*f.x;
    precise vec4 bottom=d+(e-d)*f.x;
    precise vec4 color=top+(bottom-top)*f.y;
